{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"types": [
			"node"
		],
		"rootDir": "src",
		"outDir": "dist",
		"noEmitOnError": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.cts"
	],
	"exclude": [
		"src/kurot"
	]
}
