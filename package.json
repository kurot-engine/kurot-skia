{
	"name": "@kurot/skia",
	"version": "0.1.0",
	"private": true,
	"description": "Build-time resource and KUI skin entry generation for Kurot applications",
	"type": "module",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"docs"
	],
	"exports": {
		"./project": {
			"types": "./dist/kurot/index.d.ts",
			"import": "./dist/kurot/index.js"
		}
	},
	"bin": {
		"kurot-project": "./dist/kurot/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
		"generate:demo": "node dist/kurot/cli.js --project ../Kurot-Skia-Demo"
	},
	"dependencies": {
		"@kurot/bitmap-font": "0.1.0",
		"@kurot/cli": "3.6.0",
		"@kurot/ui-document": "0.13.1",
		"chokidar": "4.0.3",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@types/node": "^22.20.5"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.33.0"
}
